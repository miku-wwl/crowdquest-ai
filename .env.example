# Planned consumer configuration; Phase 0 has no application entrypoint.
# Leave secrets blank. Never put live values in this tracked file.
CROWDQUEST_HOST=127.0.0.1
CROWDQUEST_PORT=8000
CROWDQUEST_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Set a private absolute directory outside the repository before future startup.
CROWDQUEST_STATE_DIR=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://127.0.0.1:8000/auth/twitch/callback
TWITCH_BROADCASTER_ID=
# Phase 1: user:read:chat only. No message sending or moderation authority.
# OAuth tokens belong in an OS/private credential store, not this file.
# Phase 3 provider/credential selection is deferred; no provider call is authorized.
# Runtime capability and overlay credentials are provisioned separately in private state.
