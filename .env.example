# Optional process environment override, outside the checkout.
# The consumer does not load .env automatically. Default is LOCALAPPDATA/CrowdQuestAI/phase1.
CROWDQUEST_STATE_DIR=
# Configure Client ID and owned broadcaster login with: uv run python -m crowdquest.setup
# Client Secret and OAuth tokens go directly to Windows Credential Manager.
# Exact default redirect: http://localhost:8000/auth/twitch/callback
# Phase 1 requests only user:read:chat. No provider or AIG execution configuration.
